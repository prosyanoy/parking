<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapZoomInFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="183dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        app:borderWidth="0dp"
        app:collapsedSize="43dp"
        app:layout_constraintEnd_toEndOf="@+id/uiMapSearchFAB"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/fab_bottom_square"
        app:icon="@drawable/ic_plus" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapZoomOutFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="436dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        app:collapsedSize="43dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/uiMapZoomInFAB"
        app:layout_constraintTop_toBottomOf="@+id/uiMapZoomInFAB"
        app:layout_constraintVertical_bias="0.0"
        app:shapeAppearanceOverlay="@style/fab_top_square"
        app:icon="@drawable/ic_minus" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapMenuFAB"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginStart="10dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        app:borderWidth="0dp"
        app:collapsedSize="43dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/uiMapSearchFAB"
        app:icon="@drawable/ic_sliders" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uiMapDepositButton"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="0dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:iconGravity="textStart"
        app:layout_constraintStart_toEndOf="@+id/uiMapBalanceButton"
        app:layout_constraintTop_toTopOf="@+id/uiMapSearchFAB"
        app:shapeAppearanceOverlay="@style/fab_left_square"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/primary" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapSearchFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        app:borderWidth="0dp"
        app:collapsedSize="43dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:icon="@drawable/ic_magnifying_glass" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapLocationFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        app:borderWidth="0dp"
        app:collapsedSize="43dp"
        app:layout_constraintEnd_toEndOf="@+id/uiMapSearchFAB"
        app:layout_constraintTop_toBottomOf="@+id/uiMapZoomOutFAB"
        app:icon="@drawable/ic_navigation_arrow" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapAccessibleFAB"
        android:layout_width="42dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="0dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        android:padding="0dp"
        app:borderWidth="0dp"
        app:collapsedSize="43dp"
        app:icon="@drawable/ic_wheelchair"
        app:layout_constraintEnd_toEndOf="@+id/uiMapSearchFAB"
        app:layout_constraintTop_toBottomOf="@+id/uiMapLocationFAB" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/uiMapInfoFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        app:borderWidth="0dp"
        app:collapsedSize="43dp"
        app:layout_constraintEnd_toEndOf="@+id/uiMapAccessibleFAB"
        app:layout_constraintTop_toBottomOf="@+id/uiMapAccessibleFAB"
        app:icon="@drawable/ic_question_mark"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uiMapBalanceButton"
        android:layout_width="wrap_content"
        android:layout_height="43dp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="76dp"
        android:backgroundTint="@color/white"
        android:clickable="true"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/ruble"
        android:letterSpacing="0"
        android:textColor="@color/black"
        android:textSize="18dp"
        app:layout_constraintStart_toEndOf="@+id/uiMapMenuFAB"
        app:layout_constraintTop_toTopOf="@+id/uiMapDepositButton"
        app:shapeAppearanceOverlay="@style/fab_right_square" />


</androidx.constraintlayout.widget.ConstraintLayout>