<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/root"
    android:background="@drawable/bottom_sheet_background"
    android:clickable="true"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:behavior_fitToContents="false"
    app:behavior_expandedOffset = "0dp"
    app:behavior_halfExpandedRatio = "0.55"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">



        <View
            android:id="@+id/view"
            android:layout_width="50dp"
            android:layout_height="7dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/rounded_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/address"
            app:layout_constraintTop_toBottomOf="@+id/view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/payment"
            app:layout_constraintBottom_toTopOf="@id/distance_to"
            android:text="Виноградная, 122А"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/payment"
            app:layout_constraintStart_toEndOf="@id/address"
            app:layout_constraintTop_toBottomOf="@+id/view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/reserve"
            android:text="100 Р / час"
            android:textStyle="bold"
            android:textSize="25sp"/>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/distance_to"
            app:layout_constraintTop_toBottomOf="@+id/address"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/payment"
            app:layout_constraintBottom_toTopOf="@id/parking_lots"
            android:layout_marginTop="10sp">




                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/icon_distance_to"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/text_distance_to"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/ic_car"
                    android:layout_marginRight="10sp"/>




                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/text_distance_to"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_distance_to"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:lines="2"
                    android:text="560 м \n 2 минуты"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/parking_lots"
            app:layout_constraintTop_toBottomOf="@+id/distance_to"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/payment"
            app:layout_constraintBottom_toTopOf="@id/secure"
            android:layout_marginTop="5sp">


                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/icon_parking_lots"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/text_parking_lots"
                    android:layout_marginRight="10sp"
                    android:text="P"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="24dp"
                    android:gravity="center"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/text_parking_lots"
                    app:layout_constraintStart_toEndOf="@id/icon_parking_lots"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:lines="2"
                    android:text="17 мест \n 4 свободных"/>


        </androidx.constraintlayout.widget.ConstraintLayout>





        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/secure"
            app:layout_constraintTop_toBottomOf="@id/parking_lots"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/all_day"
            android:layout_marginTop="5sp"
            android:src="@drawable/ic_secure_active" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/all_day"
            app:layout_constraintTop_toBottomOf="@id/parking_lots"
            app:layout_constraintStart_toEndOf="@id/secure"
            app:layout_constraintEnd_toStartOf="@id/charge"
            android:layout_marginTop="5sp"
            android:src="@drawable/ic_247_active"/>


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/charge"
            app:layout_constraintTop_toBottomOf="@id/parking_lots"
            app:layout_constraintStart_toEndOf="@id/all_day"
            app:layout_constraintEnd_toStartOf="@id/disability"
            android:layout_marginTop="5sp"
            android:src="@drawable/ic_charge_active"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/disability"
            app:layout_constraintTop_toBottomOf="@id/parking_lots"
            app:layout_constraintStart_toEndOf="@id/charge"
            app:layout_constraintEnd_toStartOf="@id/payment"
            android:layout_marginTop="5sp"
            android:src="@drawable/ic_disability_active"/>




        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/reserve"
            app:layout_constraintTop_toBottomOf="@+id/secure"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/go_now"
            android:layout_marginTop="5sp"
            android:text="Зарезервировать"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/go_now"
            app:layout_constraintTop_toBottomOf="@id/secure"
            app:layout_constraintStart_toEndOf="@id/reserve"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5sp"
            android:text="Заехать сейчас"/>



</androidx.constraintlayout.widget.ConstraintLayout>