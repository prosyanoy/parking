<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/infoFragmentLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="18dp"
        android:padding="1dp"
        android:src="@drawable/ic_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="0dp"
        android:layout_height="23dp"
        android:layout_marginTop="-5dp"
        android:gravity="top"
        android:paddingStart="12dp"
        android:text="ПроПарковки"
        android:textColor="@color/black_text"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/infoFragmentLogo"
        app:layout_constraintTop_toTopOf="@+id/infoFragmentLogo" />

    <TextView
        android:id="@+id/versionText"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:paddingStart="12dp"
        android:text="@string/app_version"
        android:textColor="@color/black_text"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/textView2"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36sp"
        android:layout_marginLeft="-2sp"
        android:text="Единый контакт-центр"
        android:textColor="@color/black_text"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@+id/infoFragmentLogo"
        app:layout_constraintTop_toBottomOf="@+id/infoFragmentLogo" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+7 (962) 944-42-00"
        android:textColor="@color/on_boarding_primary_purple"
        android:textStyle="bold"
        android:textSize="15sp"
        android:autoLink="phone"
        android:textColorLink="@color/on_boarding_primary_purple"
        app:layout_constraintStart_toStartOf="@+id/textView5"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />


    <TextView
        android:id="@+id/yandexPolicy"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:autoLink="web"
        android:layout_marginTop="36dp"
        android:text="Условия использования Яндекс.Карт"
        android:textColor="@color/on_boarding_primary_purple"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/textView6"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <TextView
        android:id="@+id/appPolicy"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:text="Условия пользовательского соглашения"
        android:textColor="@color/on_boarding_primary_purple"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/yandexPolicy"
        app:layout_constraintTop_toBottomOf="@+id/yandexPolicy" />

    <TextView
        android:id="@+id/personalData"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:gravity="center_vertical"

        android:text="Согласие на обработку персональных данных"
        android:textColor="@color/on_boarding_primary_purple"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/appPolicy"
        app:layout_constraintTop_toBottomOf="@+id/appPolicy" />


</androidx.constraintlayout.widget.ConstraintLayout>