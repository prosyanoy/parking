<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottom_sheet_filters"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_background"
        app:behavior_hideable="true"
        app:layout_behavior=".filters.BottomSheetFilters">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Фильтры"
                android:textColor="@color/black"
                android:textSize="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCloseFilters"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconSize="45dp"
                app:iconTint="@color/black"
                style="@style/Widget.Material3.Button.IconButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="Тип парковки"
            android:textSize="28dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Бесплатные парковки"
                android:textColor="@color/black"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.App.CheckBox"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Занятые парковки"
                android:textColor="@color/black"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.App.CheckBox"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Открытые парковки"
                android:textColor="@color/black"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.App.CheckBox"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:text="Сервис"
            android:textSize="28dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:id="@+id/guard"
                android:layout_marginEnd="35dp"
                android:layout_marginStart="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:icon="@drawable/ic_shieldcheck"
                    app:iconGravity="textTop"
                    app:iconSize="155dp"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Безопасная"
                android:textSize="24dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/guard"
                app:layout_constraintStart_toStartOf="@+id/guard"
                app:layout_constraintTop_toBottomOf="@+id/guard" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:id="@+id/fullDay"
                android:layout_marginStart="35dp"
                app:layout_constraintStart_toEndOf="@id/guard"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="150dp"
                    android:layout_height="150dp"

                    android:fontFamily="@font/overpass_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="24/7"
                    android:autoSizeTextType="uniform"
                    android:textStyle="bold" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/textView_fullDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Круглосуточная"
                android:textSize="24dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/fullDay"
                app:layout_constraintStart_toStartOf="@+id/fullDay"
                app:layout_constraintTop_toBottomOf="@+id/fullDay" />




            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/buttery_charge"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:layout_constraintEnd_toEndOf="@+id/guard"
                app:layout_constraintStart_toStartOf="@+id/guard"
                app:layout_constraintTop_toTopOf="@id/wheel">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:icon="@drawable/ic_battery_with_charger_svgrepo_com"
                    app:iconGravity="textTop"
                    app:iconSize="150dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="С подзарядкой"
                android:textSize="24dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/buttery_charge"
                app:layout_constraintStart_toStartOf="@+id/buttery_charge"
                app:layout_constraintTop_toBottomOf="@+id/buttery_charge" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/wheel"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:layout_constraintEnd_toEndOf="@+id/fullDay"
                app:layout_constraintStart_toStartOf="@+id/fullDay"
                app:layout_constraintTop_toBottomOf="@id/textView_fullDay">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:icon="@drawable/ic_wheelchair"
                    app:iconGravity="textTop"
                    app:iconSize="150dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Места для\nинвалидов"
                android:textSize="24dp"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="@+id/wheel"
                app:layout_constraintStart_toStartOf="@+id/wheel"
                app:layout_constraintTop_toBottomOf="@+id/wheel"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:checked="false"
            android:text="Онлайн оплата"
            android:textSize="24dp"
            style="@style/Widget.App.Switch"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>