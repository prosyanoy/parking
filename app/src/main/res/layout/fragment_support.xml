<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="570dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Тема"
            android:textAppearance="@style/Headline"
            android:textColor="@color/darkGrey"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@+id/themeBtn"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/themeBtn"
            android:layout_width="328dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/transparent_bg_selector"
            android:text="Выберите тему"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            android:textColor="@color/darkGrey"
            android:textSize="15sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_button_arrowdown"
            app:iconGravity="end"
            app:iconTint="@color/on_boarding_primary_purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/theme" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageFieldContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeBtn">

            <TextView
                android:id="@+id/messageFieldHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Текст"
                android:textAppearance="@style/Headline"
                android:textColor="@color/darkGrey"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@+id/messageField"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messageField"
                android:layout_width="328dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/transparent_bg_selector"
                android:gravity="start"
                android:hint="Опишите проблему"
                android:minHeight="244dp"
                android:maxHeight="400dp"
                android:paddingHorizontal="12dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/messageFieldHeader" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/sendBtn"
        android:layout_width="328dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.6"
        android:background="@drawable/button_selector"
        android:text="Отправить"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="17sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout" />


</androidx.constraintlayout.widget.ConstraintLayout>