<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/on_boarding_background_grey"
    tools:context=".users_intro.OnBoardingFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/onBoardingImageViewMapPicture"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/onBoardingEndVerticalGuideline"
        app:layout_constraintBottom_toBottomOf="@id/onBoardingFabGuideline"
        app:srcCompat="@drawable/on_boarding_map_picture"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/onBoardingImageViewCirclesGeolocation"
        android:layout_width="293dp"
        android:layout_height="290dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="90dp"
        app:layout_constraintBottom_toTopOf="@id/onBoardingFabGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/on_boarding_circles_background"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/onBoardingImageViewCirclesGeolocationBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="matrix"
        android:rotation="180"
        android:layout_marginBottom="-18dp"
        app:layout_constraintBottom_toTopOf="@id/onBoardingImageViewCirclesGeolocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/onBoardingGeolocationVerticalGuideline"
        app:srcCompat="@drawable/on_boarding_circles_background"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/onBoardingTextGeolocation"
        android:textSize="@dimen/on_boarding_text_size_18sp"
        android:layout_width="0dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:textColor="@color/on_boarding_geolocation_text_color_white"
        app:layout_constraintTop_toTopOf="@id/onBoardingImageViewCirclesGeolocation"
        app:layout_constraintBottom_toBottomOf="@id/onBoardingImageViewCirclesGeolocation"
        app:layout_constraintStart_toStartOf="@id/onBoardingImageViewCirclesGeolocation"
        app:layout_constraintEnd_toEndOf="@id/onBoardingImageViewCirclesGeolocation"
        android:text="@string/on_boarding_geolocation_text"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/onBoardingDownHorizontalGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.587" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/onBoardingStartVerticalGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="-0.23" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/onBoardingEndVerticalGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="1.22" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/onBoardingGeolocationVerticalGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.843" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/onBoardingFabGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.829"/>

</androidx.constraintlayout.widget.ConstraintLayout>
