<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <stroke android:width="1dp" android:color="@color/darkGrey" />

            <solid android:color="@android:color/transparent" />

            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <stroke android:width="1dp" android:color="@color/on_boarding_primary_purple" />

            <solid android:color="@android:color/transparent" />

            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>

</selector>